# Токен Telegram бота (получить у @BotFather)
BOT_TOKEN=your_bot_token_here

# ID чата для пересылки обращений
APPEAL_CHAT_ID=-1002863620257

# ID чата для пересылки заявок на вступление
APPLICATION_CHAT_ID=-1002692926810

# Примечание: Скопируйте этот файл как .env и заполните реальными значениями

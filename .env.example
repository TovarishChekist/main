# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Security Settings
# Master encryption key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
MASTER_KEY=

# Database encryption key (generate separately)
DB_ENCRYPTION_KEY=

# Session Settings
SESSION_TIMEOUT=3600
MAX_MESSAGE_SIZE=4096

# Rate Limiting
MAX_REQUESTS_PER_MINUTE=30
MAX_REQUESTS_PER_HOUR=500

# Logging (never log sensitive data)
LOG_LEVEL=INFO
LOG_FILE=bot.log

# Advanced Settings
ENABLE_STEGANOGRAPHY=true
ENABLE_FORWARD_SECRECY=true
AUTO_DELETE_KEYS_HOURS=24
